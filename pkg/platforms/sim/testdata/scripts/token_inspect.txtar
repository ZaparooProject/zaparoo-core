# tokens.resolve reports what the last card would run and which indexed game
# it launches, and the reader setup methods answer for the sim driver.

sim-start
rom snes/Alpha.sfc
index SNES

! api tokens.resolve
stderr 'no token has been read'

tap -uid 04aa11 $ROMS/snes/Alpha.sfc
notification media.started systemId=SNES
api tokens.resolve
stdout '"uid": "04aa11"'
stdout '"script": ".*Alpha.sfc"'
stdout '"system": "SNES"'
stdout '"name": "Alpha"'
remove

api readers.drivers
stdout '"id": "sim"'
api readers.ports {"driver":"sim"}
stdout '"ports": \[\]'
