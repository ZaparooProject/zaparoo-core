<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <AssemblyName>ZaparooPlaynite</AssemblyName>
    <RootNamespace>ZaparooPlaynite</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>

    <!-- Keep in step with extension.yaml and ZaparooPlugin.PluginVersion -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <FileVersion>1.0.0</FileVersion>

    <Product>Zaparoo Playnite Extension</Product>
    <Company>The Zaparoo Project</Company>
    <Copyright>Copyright © 2026 The Zaparoo Project Contributors</Copyright>
    <Description>Playnite integration extension for Zaparoo</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Playnite supplies its own SDK assembly at runtime -->
    <PackageReference Include="PlayniteSDK" Version="6.11.0" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Management" />
    <Reference Include="System.Xaml" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <ItemGroup>
    <None Include="extension.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
