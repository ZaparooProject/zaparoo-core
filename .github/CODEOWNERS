/.signpath/ @ZaparooProject/admins

# Adding a key here makes every device trust manifests signed with it, and
# removing one revokes it fleet-wide.
/pkg/service/updater/otameta/keys/ @ZaparooProject/admins

# The OTA publishing path reaches the update signing key. Editing any of it
# could route the key somewhere the ota-publish environment's required
# reviewers never see, so it needs the same review as the key itself.
/.github/workflows/ota-*.yml @ZaparooProject/admins
/.github/actions/ota-metadata/ @ZaparooProject/admins
/scripts/generate-update-manifest/ @ZaparooProject/admins
